# Environment Configuration

# Server Port
PORT=3000

# LLM Provider Selection ('auto' | 'openai' | 'ollama' | 'gemini' | 'builtin')
LLM_PROVIDER=auto

# OpenAI API Key (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama Local LLM Configuration (Optional)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Google Gemini API Key (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
